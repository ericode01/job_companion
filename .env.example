# Copy to .env.local (repo root). Never commit .env.local.

# AI. Each model setting in Admin -> Models names its provider ("anthropic:claude-sonnet-5",
# "openrouter:deepseek/deepseek-v4-flash"), so set the key for whichever providers you use.
# Company research needs Anthropic; the cheap extraction defaults need OpenRouter.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Email digest — your own mailbox (Gmail needs an app password, not your login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=
# Optional: defaults to SMTP_USER
DIGEST_FROM=

# Or send through Resend instead (choose it in Admin → Email delivery)
RESEND_API_KEY=

# Mailbox sync: Google sign-in for read-only Gmail (Admin → Mailbox sync lists the setup steps).
# Without these, people connect by IMAP app password instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts stored mailbox credentials. Required when hosted; locally a key file is generated in data/.
# Generate one with: openssl rand -base64 32
# SECRET_KEY=

# Optional: override where app.db and files live (default: <repo>/data)
# DATA_DIR=

# --- Hosting (leave unset for local development on http://127.0.0.1:4317) ---
# The public https address people use. Sets the allowed Host/Origin, secure cookies, links in
# emails and invites, and (at build time) the server the Chrome extension talks to.
# APP_ORIGIN=https://jobs.example.com
# Where the server listens. Behind a reverse proxy on the same machine, keep 127.0.0.1.
# HOST=127.0.0.1
# PORT=4317

